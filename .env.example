# Used by docker compose. Keep this file secret-free and copy it to .env.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Customer password reset email via Resend. Verify the sender domain in Resend.
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM="IndusCart <no-reply@your-verified-domain.com>"
# Local Grafana login for the monitoring Compose overlay. Replace before first start.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Optional overrides. Keep the default Mongo URI when using the Compose mongo service.
# DOCKER_MONGO_URI=mongodb://mongo:27017/induscart
# VITE_API_URL=http://localhost:5000
# CORS_ORIGINS=http://localhost:3000
