# Keep the application database-provider neutral by changing only this URI.
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/induscart
# MongoDB Atlas or another Mongo-compatible provider:
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/induscart
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
# Generate a unique 32+ character value; required before provider secrets can be saved.
# Keep this key stable and back it up separately: rotating it requires re-encrypting stored credentials.
SETTINGS_ENCRYPTION_KEY=replace-with-a-unique-random-secret-at-least-32-characters
# Email (password reset, order confirmation). FRONTEND_URL is the public store URL used in email links.
FRONTEND_URL=http://localhost:3000
# Option 1 - Resend with your own verified domain (onboarding@resend.dev only reaches your own inbox):
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM="IndusCart <no-reply@your-verified-domain.com>"
# Option 2 - SMTP, e.g. Gmail with a Google App Password (Google Account > Security > App passwords).
# When SMTP_* is set it is used instead of Resend.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourstore@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# Optional comma-separated browser origins. Leave blank for current local behavior.
# CORS_ORIGINS=http://localhost:3000,http://192.168.1.226:3000
# NODE_ENV=production
# Proxy hops to trust for client IPs (default 1 on Vercel). Set to 1 behind nginx.
# TRUST_PROXY=1
# Optional: protect /metrics with a Bearer token (it is hidden on Vercel when unset).
# METRICS_TOKEN=replace-with-a-random-token
