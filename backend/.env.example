# Keep the application database-provider neutral by changing only this URI.
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/induscart
# MongoDB Atlas or another Mongo-compatible provider:
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/induscart
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
# Generate a unique 32+ character value; required before provider secrets can be saved.
# Keep this key stable and back it up separately: rotating it requires re-encrypting stored credentials.
SETTINGS_ENCRYPTION_KEY=replace-with-a-unique-random-secret-at-least-32-characters
# Customer password reset email via Resend. Use a verified sender domain.
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM="IndusCart <no-reply@your-verified-domain.com>"
# Optional comma-separated browser origins. Leave blank for current local behavior.
# CORS_ORIGINS=http://localhost:3000,http://192.168.1.226:3000
# NODE_ENV=production
