{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-force-exit",
    "test:unit": "node --test test/*.test.js",
    "test:integration": "node --test test/integration*.test.js test/*.test.js",
    "test:selenium": "RUN_SELENIUM=true node --test test/selenium.smoke.test.js",
    "check": "node --check server.js && node --check config/env.js && node --check config/db.js && node --check controllers/authController.js && node --check controllers/orderController.js && node --check routes/authRoutes.js && node --check scripts/bootstrapAdmin.js && node --check scripts/resetAdminPassword.js",
    "admin:bootstrap": "node scripts/bootstrapAdmin.js",
    "admin:reset-password": "node scripts/resetAdminPassword.js",
    "db:backup": "node scripts/dbBackup.js",
    "db:restore": "node scripts/dbRestore.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.1",
    "mongoose": "^9.4.1",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
